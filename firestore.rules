rules_version = '2';
// Firestore של kupat-bet-kneset משותף לכמה אפליקציות:
// synagogue-app (בית המדרש אלי בעזרי), member.html, רשי (rashi-kneset), קרן השיעורים, אסיפת כספים NY (ny-asifa).
// כתיבה — רק מחשבון Google של המשתמש. האפליקציות מציגות כפתור "התחבר עם Google".
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['m0509766686@gmail.com', 'malkielnili@gmail.com'];
    }

    // קריאה פתוחה: קישורי הכרטסת למתפללים (member.html) וקרן השיעורים קוראים בלי התחברות
    match /synagogue/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // כל השאר (כולל ny_donations) — רק לבעלים
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
